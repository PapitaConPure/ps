{
  "name": "ps",
  "version": "1.1.0",
  "module": "src/index.js",
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bun": "^1.3.6",
    "@types/node": "^25.0.9",
    "@types/sizeof": "^1.0.3",
    "chalk": "^5.6.2",
    "globals": "^17.0.0",
    "sizeof": "^1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "description": "PuréScript (no confundir con PureScript) es un lenguaje de scripting de comandos personalizados de servidor para Bot de Puré",
  "private": true,
  "scripts": {
    "lint": "bunx biome lint",
    "lint:fix": "bunx biome lint --write",
    "format": "bunx biome format",
    "format:fix": "bunx biome format --write",
    "check": "bun run lint && bun run format",
    "fix": "bun run lint:fix && bun run format:fix",
    "build:node": "bun build ./src/index.ts --outdir ./dist --entry-naming \"[dir]/puréscript.bundle.node.js\" --format esm --plugins dts",
    "build:browser": "bun build ./src/index.ts --outdir ./dist --entry-naming \"[dir]/puréscript.bundle.js\" --target browser",
    "build:all": "bun run build:node && bun run build:browser"
  },
  "type": "module",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.88",
    "axios": "^1.13.2"
  }
}
